<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_ai_nav</name>
  <version>1.0.0</version>
  <description>LeKiwi三轮全向轮底盘+Realsense D435i智能导航Demo — 集成Nav2/SLAM/AMCL/自动巡逻/YOLO目标检测</description>
  <maintainer email="3467934040@qq.com">zbx</maintainer>
  <license>Apache-2.0</license>

  <!-- 构建工具依赖 -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS2核心依赖 -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>

  <!-- Nav2全栈依赖 -->
  <depend>nav2_bringup</depend>
  <depend>nav2_common</depend>
  <depend>nav2_navfn_planner</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_waypoint_follower</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_amcl</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_velocity_smoother</depend>
  <depend>slam_toolbox</depend>

  <!-- Robot & Sensor -->
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>depthimage_to_laserscan</depend>

  <!-- Gazebo仿真 -->
  <depend>gazebo_ros</depend>
  <depend>gazebo_plugins</depend>

  <!-- RViz & Teleop -->
  <depend>rviz2</depend>
  <depend>teleop_twist_keyboard</depend>

  <!-- Python额外依赖（通过pip安装） -->
  <!-- ultralytics, opencv-python, numpy, pyserial -->

  <!-- 测试依赖 -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

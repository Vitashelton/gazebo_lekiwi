Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15

    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
      Update Topic:
        Value: /map_updates
      Color Scheme: map
      Draw Behind: false

    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic:
        Value: /plan
      Color: 0; 255; 0

    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
      Color: 0; 200; 255

    - Class: rviz_default_plugins/Costmap
      Name: Global Costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap

    - Class: rviz_default_plugins/Costmap
      Name: Local Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
      Size (m): 0.01
      Style: Points

    - Alpha: 1.0
      Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true

    - Class: rviz_default_plugins/MarkerArray
      Name: ParticleCloud
      Enabled: true
      Topic:
        Value: /particle_cloud

    - Class: rviz_default_plugins/MarkerArray
      Name: YOLO BBoxes
      Enabled: true
      Topic:
        Value: /yolo/bbox_markers

    - Class: rviz_default_plugins/Image
      Name: CameraImage
      Enabled: false
      Topic:
        Value: /camera/color/image_raw

    - Class: rviz_default_plugins/Image
      Name: YOLO Detection
      Enabled: true
      Topic:
        Value: /yolo/detection_image

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10.0
      Focal Point: [0.0, 0.0, 0.0]
      Pitch: 0.785
      Yaw: 0.785
    Saved: ~

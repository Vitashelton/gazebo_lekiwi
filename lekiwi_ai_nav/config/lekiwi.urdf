<?xml version="1.0"?>
<!-- ====================================================================== -->
<!-- LeKiwi 三轮全向轮底盘 URDF — ROS2 Humble + Gazebo 仿真                  -->
<!-- ====================================================================== -->
<robot name="lekiwi">

  <!-- ==================================================================== -->
  <!-- Material 定义                                                        -->
  <!-- ==================================================================== -->
  <material name="gray"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="silver"><color rgba="0.7 0.7 0.7 1.0"/></material>
  <material name="red"><color rgba="1.0 0.1 0.1 1.0"/></material>
  <material name="green"><color rgba="0.1 0.8 0.1 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.2 1.0 1.0"/></material>

  <!-- ==================================================================== -->
  <!-- Links                                                                -->
  <!-- ==================================================================== -->

  <!-- 足迹原点 (投影到地面) -->
  <link name="base_footprint"/>

  <!-- 机身主体 -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.15" ixy="0.0" ixz="0.0" iyy="0.15" iyz="0.0" izz="0.2"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- 全向轮1 (前方) -->
  <link name="wheel_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- 全向轮2 (左后方) -->
  <link name="wheel_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- 全向轮3 (右后方) -->
  <link name="wheel_3">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- D435i 相机外壳 -->
  <link name="d435_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- 相机光学帧 -->
  <link name="d435_depth_optical_frame"/>
  <!-- LiDAR 帧 -->
  <link name="laser_frame"/>

  <!-- ==================================================================== -->
  <!-- Joints                                                               -->
  <!-- ==================================================================== -->

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <joint name="wheel_1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_1"/>
    <origin xyz="0.15 0.0 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <joint name="wheel_2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_2"/>
    <origin xyz="-0.08 -0.14 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <joint name="wheel_3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_3"/>
    <origin xyz="-0.08 0.14 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <joint name="d435_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d435_link"/>
    <origin xyz="0.15 0 0.14" rpy="0 0 0"/>
  </joint>

  <joint name="d435_optical_joint" type="fixed">
    <parent link="d435_link"/>
    <child link="d435_depth_optical_frame"/>
    <!-- ROS 相机标准: z向前, x向右, y向下 -->
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.08 0 0.16" rpy="0 0 0"/>
  </joint>

  <!-- ==================================================================== -->
  <!-- Gazebo 插件                                                          -->
  <!-- ==================================================================== -->

  <!-- 全向运动驱动: 订阅 /cmd_vel, 发布 /odom + odom->base_footprint TF -->
  <gazebo>
    <plugin name="planar_drive" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>/</namespace></ros>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_rate>30.0</odometry_rate>
      <velocity_y_axis>1</velocity_y_axis>
      <velocity_yaw_axis>2</velocity_yaw_axis>
    </plugin>
  </gazebo>

  <!-- RGB 相机: 发布 /d435/color/image_raw -->
  <gazebo reference="d435_link">
    <sensor type="camera" name="d435_color_sensor">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.08559</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>10</far></clip>
      </camera>
      <plugin name="d435_color_plugin" filename="libgazebo_ros_camera.so">
        <ros><namespace>d435/color</namespace></ros>
        <camera_name>d435_color</camera_name>
        <frame_name>d435_depth_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 2D LiDAR: 发布 /scan -->
  <gazebo reference="laser_frame">
    <sensor type="ray" name="laser_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>/</namespace></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
        <topic_name>scan</topic_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>

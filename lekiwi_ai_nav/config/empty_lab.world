<?xml version="1.0"?>
<!-- ====================================================================== -->
<!-- LeKiwi 实验室仿真环境 — Gazebo World                                      -->
<!-- ====================================================================== -->
<!-- 功能: 提供一个包含围墙、障碍物的室内测试环境，用于导航和巡逻测试            -->
<!-- 大小: 10m x 10m 室内空间，含走廊和房间布局                                 -->
<!-- ====================================================================== -->
<sdf version="1.6">
  <world name="lekiwi_lab">

    <!-- === 物理引擎 === -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <!-- === 全局光照 === -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.8 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- === 太阳光 === -->
    <light name="sun" type="directional">
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <direction>0 0.5 -0.8</direction>
    </light>

    <!-- === 地面 === -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ================================================================== -->
    <!-- 实验室围墙 (10m x 10m) — 用简单的box拼成                            -->
    <!-- ================================================================== -->

    <!-- 北墙 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.0 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.0 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1.0</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 南墙 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.0 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.0 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1.0</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 东墙 -->
    <model name="wall_east">
      <static>true</static>
      <pose>5.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1.0</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 西墙（中间开口作为走廊入口） -->
    <model name="wall_west_north">
      <static>true</static>
      <pose>-5.0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 5.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 5.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1.0</ambient></material>
        </visual>
      </link>
    </model>
    <model name="wall_west_south">
      <static>true</static>
      <pose>-5.0 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 5.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 5.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1.0</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- 室内障碍物 — 用于测试避障导航                                        -->
    <!-- ================================================================== -->

    <!-- 中心障碍物（圆柱） -->
    <model name="pillar_center">
      <static>true</static>
      <pose>0.5 0.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.3 0.3 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- 箱子障碍物1 -->
    <model name="box_obstacle_1">
      <static>true</static>
      <pose>2.0 -1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.5 0.8 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- 箱子障碍物2 -->
    <model name="box_obstacle_2">
      <static>true</static>
      <pose>-2.0 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.6 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.6 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.7 0.3 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- 箱子障碍物3 -->
    <model name="box_obstacle_3">
      <static>true</static>
      <pose>-1.5 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
          <material>
            <ambient>0.8 0.6 0.2 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- 路点标记A -->
    <model name="marker_A">
      <static>true</static>
      <pose>1.0 0.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>1.0 0.0 0.0 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- 路点标记B -->
    <model name="marker_B">
      <static>true</static>
      <pose>1.0 2.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.0 0.0 1.0 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- 路点标记C -->
    <model name="marker_C">
      <static>true</static>
      <pose>-1.0 2.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.0 1.0 0.0 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- 路点标记D -->
    <model name="marker_D">
      <static>true</static>
      <pose>-1.0 0.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>1.0 1.0 0.0 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
